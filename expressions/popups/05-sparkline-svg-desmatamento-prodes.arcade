/**
 * Título: Gráfico Embutido em SVG Inline — Série PRODES e Balanço de Cobertura
 * Perfil Arcade: Popup Element (Text / HTML + SVG)
 * Contexto: Monitoramento de Desmatamento e Conversão do Uso do Solo (PRODES / MapBiomas)
 *
 * Objetivo:
 * Renderiza diretamente no Pop-up uma barra empilhada de cobertura vegetal do município
 * (Remanescente Nativo vs. Antropizado) e um gráfico de colunas em SVG puro com a série
 * anual de supressão (2019–2024), eliminando a lentidão dos widgets nativos de gráfico.
 */

var anos = [2019, 2020, 2021, 2022, 2023, 2024];
var serie = [
    DefaultValue($feature.desmat_2019_ha, 0),
    DefaultValue($feature.desmat_2020_ha, 0),
    DefaultValue($feature.desmat_2021_ha, 0),
    DefaultValue($feature.desmat_2022_ha, 0),
    DefaultValue($feature.desmat_2023_ha, 0),
    DefaultValue($feature.desmat_2024_ha, 0)
];

// 1. Escala vertical segura para as colunas SVG
var picoAnual = Max(Max(serie), 1);
var total6Anos = Sum(serie);

var pctNativa = Constrain(DefaultValue($feature.pct_veg_nativa, 0), 0, 100);
var pctAgro = Constrain(DefaultValue($feature.pct_agropecuaria, 0), 0, 100 - pctNativa);
var pctOutros = Max(0, 100 - pctNativa - pctAgro);

// 2. Construção das barras verticais SVG (largura 276px, altura 88px)
var barrasSvg = "";
for (var i = 0; i < Count(serie); i++) {
    var val = serie[i];
    var alturaBarra = Max(Round((val / picoAnual) * 54, 1), 2);
    var x = 10 + (i * 45);
    var y = 64 - alturaBarra;
    var corBarra = IIf(i == 5, "#e4572e", "#24506b");

    barrasSvg += (
        "<rect x='" + x + "' y='" + y + "' width='30' height='" + alturaBarra + "' fill='" + corBarra + "' rx='1' />" +
        "<text x='" + (x + 15) + "' y='" + (y - 4) + "' text-anchor='middle' font-size='8.5' fill='#3d454b' font-family='monospace'>" +
            Text(val / 1000, "0.0") + "k" +
        "</text>" +
        "<text x='" + (x + 15) + "' y='79' text-anchor='middle' font-size='9' fill='#646c72' font-family='monospace'>" +
            anos[i] +
        "</text>"
    );
}

var html = (
    "<div style='font-family:system-ui,-apple-system,Segoe UI,sans-serif;background:#f6f7f5;border:1px solid #cfd4d0;padding:12px;'>" +
        "<div style='display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px;'>" +
            "<strong style='font-size:12px;text-transform:uppercase;letter-spacing:0.06em;color:#1e2328;'>Supressão Vegetal Anual (ha)</strong>" +
            "<span style='font-size:11px;font-family:monospace;color:#b83b1d;font-weight:700;'>Acumulado: " + Text(total6Anos, "#,###") + " ha</span>" +
        "</div>" +
        "<svg viewBox='0 0 280 86' width='100%' height='86' style='background:#eceeeb;border:1px solid #dcdfdc;display:block;margin-bottom:10px;'>" +
            "<line x1='6' y1='64' x2='274' y2='64' stroke='#b2b9b4' stroke-width='1' />" +
            barrasSvg +
        "</svg>" +
        "<div style='font-size:10.5px;color:#3d454b;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:4px;'>" +
            "Composição Territorial (MapBiomas)" +
        "</div>" +
        "<div style='display:flex;height:10px;width:100%;border-radius:1px;overflow:hidden;border:1px solid #b2b9b4;'>" +
            "<div style='width:" + pctNativa + "%;background:#2d6a4f;'></div>" +
            "<div style='width:" + pctAgro + "%;background:#e4572e;'></div>" +
            "<div style='width:" + pctOutros + "%;background:#9aa3a8;'></div>" +
        "</div>" +
        "<div style='display:flex;justify-content:space-between;font-size:10.5px;color:#3d454b;margin-top:5px;font-family:monospace;'>" +
            "<span>■ Nativa: " + Text(pctNativa, "0.0") + "%</span>" +
            "<span>■ Agro: " + Text(pctAgro, "0.0") + "%</span>" +
            "<span>■ Outros: " + Text(pctOutros, "0.0") + "%</span>" +
        "</div>" +
    "</div>"
);

return {
    type: "text",
    text: html
};
