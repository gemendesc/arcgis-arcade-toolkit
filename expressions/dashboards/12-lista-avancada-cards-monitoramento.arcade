/**
 * Título: Cards Executivos para Widget List com Barra Proporcional e Pílulas de Status
 * Perfil Arcade: ArcGIS Dashboards — List (Advanced Formatting)
 * Contexto: Ranking de Municípios, Bacias Hidrográficas ou Empreendimentos Críticos
 *
 * Objetivo:
 * Alimenta o template HTML do widget List com atributos pré-calculados: largura percentual
 * de barra proporcional ao valor máximo da seleção ($reference), cores condicionais de
 * pílula de severidade e métricas duplas formatadas.
 *
 * Template HTML correspondente (colar no editor Line Item Template do Dashboard):
 * <div style="padding:8px 10px;border-left:3px solid {expression/corBarra};">
 *   <div style="display:flex;justify-content:space-between;align-items:center;">
 *     <strong style="font-size:13px;color:#1e2328;">{expression/tituloItem}</strong>
 *     <span style="background:{expression/corFundoTag};color:{expression/corTextoTag};padding:1px 6px;font-size:10px;font-weight:700;">{expression/rotuloStatus}</span>
 *   </div>
 *   <div style="font-size:11px;color:#646c72;margin:3px 0 6px;">{expression/subtituloBacia}</div>
 *   <div style="background:#dce0dd;height:6px;width:100%;"><div style="background:{expression/corBarra};height:6px;width:{expression/larguraPct}%;"></div></div>
 *   <div style="display:flex;justify-content:space-between;font-size:11px;margin-top:4px;font-family:monospace;">
 *     <span>Supressão: <b>{expression/metricaPrimaria}</b></span>
 *     <span>Água: <b>{expression/metricaSecundaria}</b></span>
 *   </div>
 * </div>
 */

var areaSuprimidaHa = DefaultValue($datapoint.desmatamento_ha, 0);
var demandaHidricaHm3 = DefaultValue($datapoint.demanda_hidrica_hm3, 0);
var maximoReferenciaHa = Max(DefaultValue($reference.max_desmatamento_ha, 1), 1);

// 1. Largura relativa da barra horizontal (garante mínimo visível de 4% quando > 0)
var larguraPct = IIf(
    areaSuprimidaHa > 0,
    Constrain(Round((areaSuprimidaHa / maximoReferenciaHa) * 100, 1), 4, 100),
    0
);

// 2. Classificação combinada de prioridade territorial
var razaoPico = areaSuprimidaHa / maximoReferenciaHa;
var nivelPrioridade = When(
    razaoPico >= 0.70 || demandaHidricaHm3 >= 80, "PRIORIDADE P1",
    razaoPico >= 0.35 || demandaHidricaHm3 >= 35, "ATENÇÃO P2",
    "MONITORAMENTO P3"
);

var corBarra = When(
    nivelPrioridade == "PRIORIDADE P1", "#e4572e",
    nivelPrioridade == "ATENÇÃO P2", "#24506b",
    "#5c768d"
);

var corFundoTag = When(
    nivelPrioridade == "PRIORIDADE P1", "#fbeae5",
    nivelPrioridade == "ATENÇÃO P2", "#dce6ec",
    "#eceeeb"
);

var corTextoTag = When(
    nivelPrioridade == "PRIORIDADE P1", "#b83b1d",
    nivelPrioridade == "ATENÇÃO P2", "#1b3c51",
    "#3d454b"
);

return {
    textColor: "#1e2328",
    backgroundColor: "#f6f7f5",
    separatorColor: "#cfd4d0",
    selectionColor: "#dce6ec",
    selectionTextColor: "#1e2328",
    attributes: {
        tituloItem: DefaultValue($datapoint.nm_mun, "Município") + " (" + DefaultValue($datapoint.uf, "BR") + ")",
        subtituloBacia: "Bacia: " + DefaultValue($datapoint.nome_bacia, "Não classificada") + " · Bioma " + DefaultValue($datapoint.bioma, "Cerrado/Amazônia"),
        rotuloStatus: nivelPrioridade,
        larguraPct: Text(larguraPct, "0.0"),
        corBarra: corBarra,
        corFundoTag: corFundoTag,
        corTextoTag: corTextoTag,
        metricaPrimaria: Text(areaSuprimidaHa, "#,###") + " ha",
        metricaSecundaria: Text(demandaHidricaHm3, "#,###.0") + " hm³/ano"
    }
};
